# Hyperliquid env
HL_ADDRESS=0xYourWalletAddressHere
# Only needed for live trading. Leave blank for read-only / paper.
HL_SECRET_KEY=
HL_API_URL=https://api.hyperliquid.xyz

# Telegram (for daily report)
TG_BOT_TOKEN=
TG_CHAT_ID=

# Runtime
HLBOT_PAPER=1
# HLBOT_DB=/absolute/path/to/hlbot.sqlite
# Fresh WS snapshot (run `hlbot ws`); maker quotes price off this book.
# HLBOT_WS_SNAPSHOT=data/ws_snapshot.json

# Builder-code revenue (docs/MONETIZATION.md). Leave unset for own-account
# trading; only for routing flow of users who approved the builder.
# HL_BUILDER_ADDRESS=
# HL_BUILDER_FEE_TENTH_BPS=0
