# /etc/hl-bot/env — environment for the systemd units (chmod 600).
# Copied from this template by deploy/install.sh if absent. Fill it in.

# --- Hyperliquid ---
HL_ADDRESS=0xYourFundedTraderAddress
# The account the bot TRADES on (read + live). Defaults to HL_ADDRESS if unset.
HL_TRADER_ADDRESS=0xYourFundedTraderAddress
HL_API_URL=https://api.hyperliquid.xyz
# Live trading signs with a SEPARATE API wallet, NOT the funded key. Place it at
# ~hlbot/.config/hermes/hl-bot-api-wallet.env (chmod 600) with:
#   HL_BOT_API_PRIVATE_KEY=0x...   (64 hex; an approved API/agent wallet)
#   HL_BOT_API_WALLET_ADDRESS=0x...

# --- Database (ground truth + track record) ---
HLBOT_DB=/opt/hl-bot/data/hlbot.sqlite
HLBOT_PAPER=1

# --- Live switch (SAFETY) ---
# Empty = PAPER. The engine runs paper-only until you deliberately set this; the
# supervisor then auto-promotes agents through paper -> live_small -> live as
# their gates pass (see docs/GO_LIVE.md). Only flip after `hlbot confirm` has
# passed on real history. `hlbot kill "reason"` halts everything, sticky.
#   HLBOT_RUN_ARGS=--live --execution maker
HLBOT_RUN_ARGS=
# Legacy 5-min tick fallback (hlbot-tick.timer, disabled by default):
#   HLBOT_TICK_ARGS=--live
HLBOT_TICK_ARGS=

# --- WebSocket feed (hlbot-ws.service) ---
# The tick overlays this snapshot when fresh (<30s), else falls back to REST.
HLBOT_WS_SNAPSHOT=/opt/hl-bot/data/ws_snapshot.json
HLBOT_WS_COINS=BTC,ETH,SOL,HYPE

# --- Monitoring ---
# Dead-man switch (e.g. https://hc-ping.com/<uuid>). hlbot health pings it when ok.
HEALTHCHECK_URL=
TG_BOT_TOKEN=
TG_CHAT_ID=

# --- Backups (optional, Litestream) ---
LITESTREAM_S3_BUCKET=
LITESTREAM_S3_PATH=hl-bot/hlbot.sqlite
AWS_REGION=ap-northeast-1
# On AWS EC2, prefer the instance IAM role (deploy/aws) — leave these blank.
# Off-AWS, set static keys here instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Self-improvement loop (hlbot-loop.service; NOT enabled by default) ---
# The Ralph loop runs the `claude` CLI headlessly to research/backtest/propose
# (it never trades). Authenticate it on your Claude Max/Pro subscription (no
# metered API billing): run `claude setup-token` once and paste the result here.
# IMPORTANT: if ANTHROPIC_API_KEY is also set it takes PRECEDENCE and you'll be
# billed per-token — leave it unset to use the subscription token.
CLAUDE_CODE_OAUTH_TOKEN=
# If `claude` isn't on the systemd PATH (/usr/local/bin:/usr/bin:…), pin it:
#   CLAUDE_BIN=/usr/local/bin/claude
# Push the loop's green commits to its (dev) branch — needs git creds for hlbot:
#   RALPH_PUSH=1
