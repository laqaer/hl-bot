[Unit]
Description=hl-bot trading tick (ingest + agents + supervisor + health)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hlbot
WorkingDirectory=/opt/hl-bot
EnvironmentFile=/etc/hl-bot/env
ExecStart=/opt/hl-bot/deploy/run-tick.sh
# Don't pile up overlapping runs if one is slow.
TimeoutStartSec=300
# Hardening (full protects /usr,/etc,/boot but leaves /opt + /home writable so
# uv can manage its venv + cache; read-only home breaks uv).
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
# Shield the live trader from the OOM killer (negative score = sacrificed last).
OOMScoreAdjust=-700
