[Unit]
Description=hl-bot fine-candle harvest (HL keeps ~5000 bars/interval; append before they expire)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hlbot
WorkingDirectory=/opt/hl-bot
EnvironmentFile=/etc/hl-bot/env
# --sync-peer: union-merge with the ralph loop clone's store so either
# harvester dying can't gap the irreplaceable 1m sample (B-STORESYNC);
# skipped quietly on hosts without the loop clone.
ExecStart=/usr/bin/env bash -c 'uv run hlbot harvest-candles --sync-peer /opt/hl-bot-loop/data/candle_store'
TimeoutStartSec=300
NoNewPrivileges=true
ProtectSystem=full
