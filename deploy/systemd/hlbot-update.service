[Unit]
Description=hl-bot auto-deploy (pull self-improvements, test-gate, restart)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runs as root: repo/test work is dropped to the hlbot user inside the script,
# but restarting units needs root. Gated by HLBOT_AUTO_UPDATE in /etc/hl-bot/env.
# Invoked via bash so a lost exec bit on update.sh cannot kill auto-deploy:
# the script shipped as 100644 from birth and every box failed 203/EXEC here,
# silently freezing deployments at their install-day commit.
ExecStart=/usr/bin/bash /opt/hl-bot/deploy/update.sh
TimeoutStartSec=600
